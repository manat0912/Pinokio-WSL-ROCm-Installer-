# Line endings: keep Linux scripts LF (they run in WSL) and Windows scripts CRLF.
*.sh  text eol=lf
*.py  text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / assets
*.ico binary
*.png binary
*.jpg binary
*.exe binary
